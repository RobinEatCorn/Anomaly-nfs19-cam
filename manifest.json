      "minVersion": 1,
      "optional": true
    },
    {
      "id": "anomaly.localization",
      "minVersion": 1
    },
    {
      "id": "anomaly.input",
      "minVersion": 1,
      "optional": true
    },
    {
      "id": "anomaly.interop.signature",
      "minVersion": 1
    },
    {
      "id": "anomaly.interop.hook",
      "minVersion": 1
    },
    {
      "id": "anomaly.json",
      "minVersion": 1,
      "optional": true
    },
    {
      "id": "anomaly.nte.session",
      "minVersion": 1,
      "optional": true
    },
    {
      "id": "anomaly.nte.player",
      "minVersion": 1,
